{
  "steps": [
    { "init": { "level": "highschool", "locale": "en" } },
    { "expectStations": ["sort"] },
    { "expectText": "Six of the twelve emails are really spam" },
    { "click": "[data-gate='lower'] button[data-ok]" },
    { "type": { "selector": "#thr1", "text": "0.35" } },
    { "expectEvent": { "verb": "answered", "station": "sort" } },
    { "expectEvent": { "verb": "station_completed", "station": "sort" } },
    { "expectText": "No spam missed, at the price of 2 false alarms" },
    { "snapshot": { "contains": ["threshold 0.35", "TP 6, FN 0, FP 2, TN 4"] } },
    { "click": "#focusNext" },
    { "expectStations": ["trade-off"] },
    { "click": "[data-gate='raise'] button[data-ok]" },
    { "type": { "selector": "#thr2", "text": "0.7" } },
    { "expectEvent": { "verb": "answered", "station": "trade-off" } },
    { "expectEvent": { "verb": "station_completed", "station": "trade-off" } },
    { "snapshot": { "contains": ["Precision 1.000, recall 0.667"] } },
    { "goto": { "station": "roc", "focus": true } },
    { "click": "[data-gate='auc'] button[data-ok]" },
    { "click": "#dsB" },
    { "expectEvent": { "verb": "answered", "station": "roc" } },
    { "type": { "selector": "#thr3", "text": "0.5" } },
    { "expectEvent": { "verb": "station_completed", "station": "roc" } },
    { "snapshot": { "contains": ["AUC of filter B 0.583", "21 of 36", "filters viewed: A, B"] } },
    { "reload": true },
    { "expectStations": ["roc"] },
    { "snapshot": { "contains": ["Filter B", "threshold 0.50", "Completed: sort, trade-off, roc"] } },
    { "click": ".levels button[data-level='2']" },
    { "expectEvent": { "verb": "level_changed" } },
    { "expectText": "Count the pairs" },
    { "click": "#dsA" },
    { "snapshot": { "contains": ["AUC of filter A 0.917", "33 of 36"] } },
    { "expectNoError": true }
  ]
}
